{
  "name": "local-note",
  "productName": "local-note",
  "version": "1.0.0",
  "description": "ローカルPCだけで動く、Notion風のデスクトップノートアプリ",
  "main": "main.js",
  "private": true,
  "license": "MIT",
  "author": "Gekko0114",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gekko0114/local-note.git"
  },
  "homepage": "https://github.com/Gekko0114/local-note#readme",
  "bugs": {
    "url": "https://github.com/Gekko0114/local-note/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir --arm64",
    "dist": "electron-builder",
    "icon": "node build/icon-source/make-icon.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "for f in main.js preload.js renderer/*.js; do node --check \"$f\" || exit 1; done"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  }
}
