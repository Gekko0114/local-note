# scripts/release.env.example
# コピーして scripts/release.env を作り、自分の値に書き換える（release.env は git 管理外）。
#
#   cp scripts/release.env.example scripts/release.env
#
# 証明書の名前。"Developer ID Application:" は付けない。
# security find-identity -v -p codesigning で確認できる。
CSC_NAME="Your Name (TEAMID)"

# 公証に使う Apple ID と、10文字のチームID。
APPLE_ID="you@example.com"
APPLE_TEAM_ID="TEAMID1234"

# アプリ用パスワードを入れたキーチェーン項目の service 名。
# 先に一度だけ登録しておく:
#   security add-generic-password -a "$APPLE_ID" -s local-note -w
KEYCHAIN_SERVICE="local-note"
